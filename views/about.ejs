<%- include('partials/header') %>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="text-center mb-5 mt-3">
            <h1 class="fw-bold mb-3">About the Initiative</h1>
            <p class="lead text-muted">A collaborative platform by the Government of Jharkhand to solve grassroots societal issues through technology and research.</p>
        </div>

        <div class="card border-0 shadow-sm mb-5">
            <div class="card-body p-5">
                <div class="row align-items-center mb-5">
                    <div class="col-md-5 mb-4 mb-md-0 text-center">
                        <div class="bg-light p-4 rounded-circle d-inline-flex" style="width: 150px; height: 150px; align-items: center; justify-content: center;">
                            <i class="bi bi-bank fs-1 text-primary"></i>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <h3 class="fw-bold mb-3">The Ministry's Vision</h3>
                        <p class="text-muted">
                            The Department of Information Technology and e-Governance, Government of Jharkhand, envisions a state where technology serves as the great equalizer. Our goal is to transform the state into a hub of innovation by directly connecting the real-world problems of our citizens with the bright minds in our universities.
                        </p>
                        <p class="text-muted">
                            By fostering this ecosystem, we ensure that research and development efforts are directly aligned with societal needs, creating a tangible impact on the ground.
                        </p>
                    </div>
                </div>

                <hr class="my-5 bg-light">

                <h3 class="fw-bold mb-4 text-center">Key Stakeholders</h3>
                
                <div class="row g-4 mt-3">
                    <div class="col-md-6">
                        <div class="d-flex p-3 bg-light rounded-3 h-100">
                            <i class="bi bi-people-fill text-primary fs-3 me-3 mt-1"></i>
                            <div>
                                <h5 class="fw-bold">Citizens of Jharkhand</h5>
                                <p class="text-muted small mb-0">The core of this initiative. Citizens from urban cities to rural villages identify and report all types of challenges they face daily—from sewage and landslides to education and healthcare.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="d-flex p-3 bg-light rounded-3 h-100">
                            <i class="bi bi-building text-success fs-3 me-3 mt-1"></i>
                            <div>
                                <h5 class="fw-bold">Universities & Academia</h5>
                                <p class="text-muted small mb-0">Students and faculty who apply their academic knowledge and research capabilities to prototype scalable solutions.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="d-flex p-3 bg-light rounded-3 h-100">
                            <i class="bi bi-briefcase-fill text-warning fs-3 me-3 mt-1"></i>
                            <div>
                                <h5 class="fw-bold">Industry Partners</h5>
                                <p class="text-muted small mb-0">Private organizations that provide funding, mentorship, and resources to help scale successful prototypes.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="d-flex p-3 bg-light rounded-3 h-100">
                            <i class="bi bi-shield-check text-info fs-3 me-3 mt-1"></i>
                            <div>
                                <h5 class="fw-bold">Government Authorities</h5>
                                <p class="text-muted small mb-0">Officials who validate problems, oversee the matching process, and monitor the overall impact of the initiatives.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        
        <div class="text-center mb-5">
            <h4 class="fw-bold mb-3">Join the Movement</h4>
            <p class="text-muted mb-4">Whether you are a citizen with a problem, a student with a solution, or an industry leader with resources, you have a role to play.</p>
            <a href="/login" class="btn btn-primary btn-lg px-5 rounded-pill">Get Involved Today</a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
