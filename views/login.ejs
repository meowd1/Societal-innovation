<%- include('partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card mt-5 shadow-sm">
            <div class="card-body">
                <h3 class="card-title text-center mb-4">Login</h3>
                
                <% if (error) { %>
                    <div class="alert alert-danger" role="alert">
                        <%= error %>
                    </div>
                <% } %>
                
                <form action="/login" method="POST">
                    <div class="mb-3">
                        <label for="email" class="form-label">Role</label>
                        <select class="form-select" id="email" name="email" required>
                            <option value="" disabled selected>Select your role...</option>
                            <option value="citizen@demo.com">Citizen</option>
                            <option value="student@demo.com">Student</option>
                            <option value="university@demo.com">University</option>
                            <option value="industry@demo.com">Industry</option>
                            <option value="admin@demo.com">Admin</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" class="form-control" id="password" name="password" required>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Login</button>
                    </div>
                </form>
                
                <div class="mt-4 text-center">
                    <p class="text-muted small"><strong>Prototype Demonstration:</strong> Password for all roles is <code>123</code>.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
