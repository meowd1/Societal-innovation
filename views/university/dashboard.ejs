<%- include('../partials/header') %>

<div class="row mb-4">
    <div class="col-12">
        <h2>University Dashboard</h2>
    </div>
</div>

<% if (locals.userRole === 'UNIVERSITY_ADMIN') { %>
    <div class="row mb-5">
        <div class="col-12">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Recommended Problems for Your University</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Match Score</th>
                                    <th>Problem Code</th>
                                    <th>Title</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% matchedProblems.forEach(m => { %>
                                    <tr>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: <%= Math.round(m.match_score * 100) %>%;" aria-valuenow="<%= Math.round(m.match_score * 100) %>" aria-valuemin="0" aria-valuemax="100"><%= Math.round(m.match_score * 100) %>%</div>
                                            </div>
                                        </td>
                                        <td><%= m.problem_code %></td>
                                        <td><%= m.title %></td>
                                        <td>
                                            <a href="/university/matches/<%= m.id %>" class="btn btn-sm btn-primary">Review & Accept</a>
                                        </td>
                                    </tr>
                                <% }) %>
                                <% if(matchedProblems.length === 0) { %>
                                    <tr><td colspan="4" class="text-center py-4">No recommended problems right now.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
<% } %>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-info">
            <div class="card-header bg-info text-dark">
                <h5 class="mb-0">Active Projects</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Problem Code</th>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% myProjects.forEach(p => { %>
                                <tr>
                                    <td><%= p.problem_code %></td>
                                    <td><%= p.problem_title %></td>
                                    <td><span class="badge bg-primary"><%= p.status %></span></td>
                                    <td>
                                        <a href="/university/projects/<%= p.id %>" class="btn btn-sm btn-outline-info">View Workspace</a>
                                    </td>
                                </tr>
                            <% }) %>
                            <% if(myProjects.length === 0) { %>
                                <tr><td colspan="4" class="text-center py-4">You have no active projects.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row mt-5">
    <div class="col-12">
        <div class="card shadow-sm border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Open Challenges Available for Opt-In</h5>
                <span class="badge bg-light text-primary"><%= availableProblems.length %> Available</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Problem Code</th>
                                <th>Title</th>
                                <th>District</th>
                                <th>Impact</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% availableProblems.forEach(p => { %>
                                <tr>
                                    <td><span class="badge bg-light text-dark border"><%= p.problem_code %></span></td>
                                    <td><%= p.title %></td>
                                    <td><%= p.district %></td>
                                    <td><%= p.affected_population_estimate %> people</td>
                                    <td>
                                        <form action="/university/projects/opt-in/<%= p.id %>" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-primary">Opt to Solve</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                            <% if(availableProblems.length === 0) { %>
                                <tr><td colspan="5" class="text-center py-4">No open challenges are currently available.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
