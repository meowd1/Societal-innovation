<%- include('partials/header') %>

<!-- Hero and Notices Section -->
<div class="row mb-5 mt-3">
    <!-- Carousel Section (Left) -->
    <div class="col-lg-8 mb-4 mb-lg-0">
        <div id="homeCarousel" class="carousel slide shadow-sm border" data-bs-ride="carousel" style="border-radius: 4px; overflow: hidden;">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
                <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="2"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active" style="height: 400px;">
                    <img src="/images/carousel_1.jpg" class="d-block w-100 h-100 object-fit-cover" alt="Smart City Innovation">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 p-3" style="border-radius: 4px; border-left: 4px solid var(--accent-color);">
                        <h3 class="fw-bold mb-1">Smart Urban Development</h3>
                        <p class="mb-0">Fostering clean tech and sustainable infrastructure for a modern Jharkhand.</p>
                    </div>
                </div>
                <div class="carousel-item" style="height: 400px;">
                    <img src="/images/carousel_2.jpg" class="d-block w-100 h-100 object-fit-cover" alt="University Students working in Robotics Lab">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 p-3" style="border-radius: 4px; border-left: 4px solid var(--accent-color);">
                        <h3 class="fw-bold mb-1">Empowering Academia</h3>
                        <p class="mb-0">Connecting brilliant university students with real-world problems.</p>
                    </div>
                </div>
                <div class="carousel-item" style="height: 400px;">
                    <img src="/images/carousel_3.jpg" class="d-block w-100 h-100 object-fit-cover" alt="Agricultural Innovation with Drones">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 p-3" style="border-radius: 4px; border-left: 4px solid var(--accent-color);">
                        <h3 class="fw-bold mb-1">Rural Innovation</h3>
                        <p class="mb-0">Bringing cutting-edge technology like drones to grassroots agriculture.</p>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>
    
    <!-- Live Challenges / Notices Sidebar (Right) -->
    <div class="col-lg-4">
        <div class="card h-100 border-0 shadow-sm" style="border-radius: 4px;">
            <div class="card-header text-white d-flex align-items-center rounded-0" style="background-color: var(--primary-color); border-bottom: 3px solid var(--accent-color);">
                <i class="bi bi-bell-fill me-2 fs-5 text-warning"></i>
                <h5 class="mb-0 fw-bold">Live Notices & Challenges</h5>
            </div>
            <div class="card-body p-0 overflow-hidden position-relative bg-white border border-top-0" style="height: 350px;">
                <!-- We use standard HTML marquee for simplicity in MVP. CSS animations can also be used. -->
                <marquee direction="up" scrollamount="3" class="h-100 p-3" onmouseover="this.stop();" onmouseout="this.start();">
                    <% if (locals.liveChallenges && locals.liveChallenges.length > 0) { %>
                        <% locals.liveChallenges.forEach(c => { %>
                            <div class="alert bg-light border border-start border-4 border-warning mb-3 shadow-none rounded-0">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-danger px-2" style="border-radius: 2px;">NEW</span>
                                    <small class="text-muted fw-bold"><%= c.problem_code %></small>
                                </div>
                                <h6 class="fw-bold mb-2 text-dark"><%= c.title %></h6>
                                <a href="/challenges" class="text-decoration-none small text-primary fw-bold">View Details <i class="bi bi-chevron-right"></i></a>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="text-center text-muted mt-5">
                            <i class="bi bi-info-circle fs-3"></i>
                            <p class="mt-2">No live challenges at the moment.</p>
                        </div>
                    <% } %>
                    
                    <div class="alert bg-light border border-start border-4 border-info mb-3 shadow-none rounded-0">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-info text-dark px-2" style="border-radius: 2px;">NOTICE</span>
                        </div>
                        <h6 class="fw-bold mb-2 text-dark">Hackathon 2026 Registration Open</h6>
                        <a href="#" class="text-decoration-none small text-primary fw-bold">Read More <i class="bi bi-chevron-right"></i></a>
                    </div>
                </marquee>
            </div>
            <div class="card-footer bg-light text-center py-2 border border-top-0 rounded-0">
                <a href="/challenges" class="text-decoration-none fw-bold" style="color: var(--primary-color);">View All Challenges</a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Ensure the object-fit works properly for carousel */
    .object-fit-cover { object-fit: cover; }
</style>

<!-- Features Section -->
<div class="row mt-5 pt-4 mb-5">
    <div class="col-12 text-center mb-5">
        <h2 class="fw-bold mb-2" style="color: var(--primary-color);">How It Works</h2>
        <div style="width: 60px; height: 4px; background-color: var(--accent-color); margin: 0 auto 1rem auto;"></div>
        <p class="text-muted fs-5">A unified ecosystem connecting all stakeholders.</p>
    </div>
    
    <div class="col-md-4 mb-4">
        <div class="card h-100 p-4 border rounded-0 bg-white" style="border-top: 4px solid var(--primary-color) !important;">
            <div class="feature-icon mb-3" style="background: var(--bg-light); color: var(--primary-color); border-radius: 4px;">
                <i class="bi bi-people-fill"></i>
            </div>
            <h4 class="fw-bold" style="color: var(--primary-color);">1. Citizens Report</h4>
            <p class="text-muted mt-2">Citizens from any city, town, or village can submit any societal or infrastructural issue they face—from urban sewage problems to rural landslides, agriculture, and healthcare.</p>
        </div>
    </div>
    
    <div class="col-md-4 mb-4">
        <div class="card h-100 p-4 border rounded-0 bg-white" style="border-top: 4px solid var(--accent-color) !important;">
            <div class="feature-icon mb-3" style="background: var(--bg-light); color: var(--accent-color); border-radius: 4px;">
                <i class="bi bi-robot"></i>
            </div>
            <h4 class="fw-bold" style="color: var(--primary-color);">2. AI & Gov Validate</h4>
            <p class="text-muted mt-2">AI immediately analyzes the problem for priority and required skills. Government officials validate and approve problems for research.</p>
        </div>
    </div>
    
    <div class="col-md-4 mb-4">
        <div class="card h-100 p-4 border rounded-0 bg-white" style="border-top: 4px solid #2e7d32 !important;">
            <div class="feature-icon mb-3" style="background: var(--bg-light); color: #2e7d32; border-radius: 4px;">
                <i class="bi bi-building"></i>
            </div>
            <h4 class="fw-bold" style="color: var(--primary-color);">3. Universities Solve</h4>
            <p class="text-muted mt-2">The portal automatically routes validated problems to appropriate university departments, where students and faculty build real-world solutions.</p>
        </div>
    </div>
</div>

<!-- Impact Section -->
<div class="row mb-5 bg-white p-5 border align-items-center" style="border-radius: 4px; border-left: 4px solid var(--primary-color) !important;">
    <div class="col-md-6">
        <h3 class="fw-bold mb-3" style="color: var(--primary-color);">Statewide Impact</h3>
        <p class="fs-5 text-muted mb-4">By connecting the brilliant minds in our universities directly with the most pressing problems of our citizens, we accelerate innovation where it matters most.</p>
        <ul class="list-unstyled">
            <li class="mb-3 d-flex align-items-center"><i class="bi bi-check-circle-fill text-success me-3 fs-5"></i> Streamlined problem resolution tracking</li>
            <li class="mb-3 d-flex align-items-center"><i class="bi bi-check-circle-fill text-success me-3 fs-5"></i> Direct integration with industry partners for funding</li>
            <li class="mb-3 d-flex align-items-center"><i class="bi bi-check-circle-fill text-success me-3 fs-5"></i> Practical experience for students solving real issues</li>
        </ul>
    </div>
    <div class="col-md-6">
        <div class="row text-center g-3 mt-4 mt-md-0">
            <div class="col-6">
                <div class="p-4 bg-light border" style="border-radius: 4px;">
                    <h2 class="fw-bold mb-0" style="color: var(--accent-color);">24+</h2>
                    <p class="text-muted small mb-0 fw-bold">Districts Covered</p>
                </div>
            </div>
            <div class="col-6">
                <div class="p-4 bg-light border" style="border-radius: 4px;">
                    <h2 class="fw-bold mb-0" style="color: var(--accent-color);">15+</h2>
                    <p class="text-muted small mb-0 fw-bold">Universities</p>
                </div>
            </div>
            <div class="col-6">
                <div class="p-4 bg-light border" style="border-radius: 4px;">
                    <h2 class="fw-bold mb-0" style="color: var(--accent-color);">500+</h2>
                    <p class="text-muted small mb-0 fw-bold">Problems Solved</p>
                </div>
            </div>
            <div class="col-6">
                <div class="p-4 bg-light border" style="border-radius: 4px;">
                    <h2 class="fw-bold mb-0" style="color: var(--accent-color);">50+</h2>
                    <p class="text-muted small mb-0 fw-bold">Industry Partners</p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
