<%- include('../partials/header') %>

<div class="row">
    <div class="col-md-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/admin/problems">Problems</a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= problem.problem_code %></li>
            </ol>
        </nav>
        
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2><%= problem.title %></h2>
            <span class="badge bg-primary fs-5"><%= problem.status %></span>
        </div>
        
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title text-muted mb-4">Problem Progress Status</h5>
                <%- include('../partials/progress_tracker', { problemStatus: problem.status, projectStatus: problem.project_status }) %>
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title text-muted border-bottom pb-2">Description</h5>
                        <p class="card-text mt-3"><%= problem.description %></p>
                        
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <h6 class="text-muted">Location Details</h6>
                                <p>
                                    <strong>District:</strong> <%= problem.district %> <br>
                                    <strong>Block:</strong> <%= problem.block || 'N/A' %> <br>
                                    <strong>Village:</strong> <%= problem.village || 'N/A' %>
                                </p>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted">Citizen Details</h6>
                                <p>
                                    <strong>Reported By:</strong> <%= problem.citizen_name %> <br>
                                    <strong>Urgency:</strong> <%= problem.citizen_priority %> <br>
                                    <strong>Affected Pop:</strong> <%= problem.affected_population_estimate || 'Unknown' %>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <% if (media && media.length > 0) { %>
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h5 class="card-title text-muted border-bottom pb-2">Evidence / Media</h5>
                            <div class="mt-3">
                                <% media.forEach(m => { %>
                                    <% if (m.mime_type && m.mime_type.startsWith('image/')) { %>
                                        <img src="<%= m.storage_path %>" class="img-fluid img-thumbnail" style="max-height: 300px;" alt="Evidence Image">
                                    <% } else { %>
                                        <a href="<%= m.storage_path %>" target="_blank" class="btn btn-outline-secondary btn-sm">View Attached Document</a>
                                    <% } %>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                <% } %>
                
                <% if (duplicates && duplicates.length > 0) { %>
                    <div class="card shadow-sm border-warning mb-4">
                        <div class="card-header bg-warning text-dark">
                            <strong>Possible Duplicates Detected</strong>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <% duplicates.forEach(d => { %>
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <a href="/admin/problems/<%= d.similar_problem_id %>"><%= d.problem_code %> - <%= d.title %></a>
                                            <br>
                                            <small class="text-muted">Similarity Score: <%= Math.round(d.similarity_score * 100) %>%</small>
                                        </div>
                                    </li>
                                <% }) %>
                            </ul>
                        </div>
                    </div>
                <% } %>
                <% if (matches && matches.length > 0) { %>
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-success text-white">
                            <strong>Matched Universities</strong>
                        </div>
                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush">
                                <% matches.forEach(m => { %>
                                    <li class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <strong><%= m.university_name %></strong>
                                            <span class="badge bg-primary">Score: <%= Math.round(m.match_score * 100) %>%</span>
                                        </div>
                                        <div class="mt-2 small text-muted">
                                            Reasons: 
                                            <% try { %>
                                                <%= JSON.parse(m.matching_reasons || '[]').join(', ') %>
                                            <% } catch(e) {} %>
                                        </div>
                                        <div class="mt-2">
                                            <span class="badge bg-secondary"><%= m.status %></span>
                                        </div>
                                    </li>
                                <% }) %>
                            </ul>
                        </div>
                    </div>
                <% } %>
            </div>
            
            <div class="col-md-4">
                <div class="card shadow-sm mb-4 bg-light border-info">
                    <div class="card-body">
                        <h5 class="card-title border-bottom border-info pb-2 text-info">AI Analysis</h5>
                        <% if (aiAnalysis) { %>
                            <p class="mt-2"><strong>Category:</strong> <%= aiAnalysis.primary_category %></p>
                            <p><strong>Priority:</strong> <span class="badge bg-danger"><%= aiAnalysis.priority %></span></p>
                            <p><strong>Required Skills:</strong><br> 
                                <% try { %>
                                    <% JSON.parse(aiAnalysis.required_skills || '[]').forEach(skill => { %>
                                        <span class="badge bg-secondary mb-1"><%= skill %></span>
                                    <% }) %>
                                <% } catch(e) {} %>
                            </p>
                            <p><strong>Summary:</strong> <small><%= aiAnalysis.summary %></small></p>
                        <% } else { %>
                            <p class="text-muted fst-italic mt-2">No AI analysis available yet.</p>
                            <form action="/api/problems/<%= problem.id %>/analyze" method="POST">
                                <button type="submit" class="btn btn-sm btn-outline-info">Run AI Analysis</button>
                            </form>
                        <% } %>
                    </div>
                </div>
                
                <div class="card shadow-sm border-primary">
                    <div class="card-body">
                        <h5 class="card-title">Admin Actions</h5>
                        <p class="small text-muted">Review the problem and validate it to proceed to University Matching.</p>
                        
                        <form action="/admin/problems/<%= problem.id %>/validate" method="POST" class="d-grid gap-2">
                            <button type="submit" name="action" value="VALIDATE" class="btn btn-success" <%= ['VALIDATED', 'REJECTED'].includes(problem.status) ? 'disabled' : '' %>>
                                VALIDATE PROBLEM
                            </button>
                            <button type="submit" name="action" value="REJECT" class="btn btn-outline-danger" <%= ['VALIDATED', 'REJECTED'].includes(problem.status) ? 'disabled' : '' %>>
                                REJECT PROBLEM
                            </button>
                        </form>
                        
                        <% if (problem.status === 'VALIDATED') { %>
                            <hr>
                            <form action="/api/problems/<%= problem.id %>/match-universities" method="POST" class="d-grid gap-2 mb-3">
                                <button type="submit" class="btn btn-primary">FIND MATCHING UNIVERSITIES</button>
                            </form>
                            
                            <h6 class="mt-3 border-top pt-3">Manual Assignment</h6>
                            <form action="/admin/problems/<%= problem.id %>/assign" method="POST">
                                <div class="mb-2">
                                    <select name="university_id" class="form-select" required>
                                        <option value="" disabled selected>Select a University</option>
                                        <% if (typeof universities !== 'undefined' && universities.length > 0) { %>
                                            <% universities.forEach(uni => { %>
                                                <option value="<%= uni.id %>"><%= uni.name %></option>
                                            <% }) %>
                                        <% } else { %>
                                            <option value="" disabled>No universities available</option>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-warning">Assign University</button>
                                </div>
                            </form>
                        <% } %>
                        <hr>
                        <h6 class="text-danger mt-3">Danger Zone</h6>
                        <form action="/admin/problems/<%= problem.id %>/delete" method="POST" class="d-grid gap-2" onsubmit="return confirm('Are you sure you want to completely delete this problem? This action cannot be undone.');">
                            <button type="submit" class="btn btn-danger">DELETE PROBLEM</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
